{
  "name": "appliance-defense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "balance": "vite-node scripts/balance.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-defense \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-defense"
  },
  "dependencies": {
    "@fontsource/jua": "^5.2.8",
    "firebase": "^13.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/three": "^0.170.0",
    "firebase-tools": "^15.36.0",
    "three": "^0.170.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
